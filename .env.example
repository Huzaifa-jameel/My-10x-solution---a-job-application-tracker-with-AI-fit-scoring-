# Copy to .env and fill in the real values. NEVER commit .env.
# Only four values must be filled to run the stack:
#   DATABASE_URL, DIRECT_URL, JWT_SECRET, GROQ_API_KEY
# Everything else has a working default.

# --- Database (Supabase) ---
# Pooler (port 6543) for the app, direct (port 5432) for Alembic migrations.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Redis (queue + cache, same instance) ---
REDIS_URL=redis://redis:6379/0

# --- LLM (Groq) ---
# Leave GROQ_API_KEY empty to force the deterministic fallback scorer.
GROQ_API_KEY=
# Verified available on 2026-09-21. Groq retires models regularly - check
# https://console.groq.com/docs/models if a call 404s.
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_INPUT_TOKENS=6000

# --- Email ---
# mailpit = the local catcher container (default, no account needed)
# smtp    = a real SMTP provider; fill SMTP_* in and set SMTP_STARTTLS=true
# file    = no network at all; each message is written to MAIL_OUTBOX_DIR
EMAIL_PROVIDER=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_OUTBOX_DIR=/app/outbox
DIGEST_FROM=jobfit@localhost
DIGEST_TO=you@example.com

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
CACHE_TTL_SECONDS=604800
DIGEST_CRON=0 8 * * MON
